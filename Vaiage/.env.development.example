# Required: DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Required: Google Maps Platform (Places, Geocoding, Directions)
MAPS_API_KEY=your_google_maps_api_key

# Optional: car rental search
RAPIDAPI_KEY=your_rapidapi_key

# Recommended for local Flask sessions
FLASK_SECRET_KEY=replace_with_a_random_secret
PORT=8000
